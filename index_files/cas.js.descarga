var editInnerHTML = "";
var deleteInnerHTML = "";
var currentRow = null;

function swapButtonsForConfirm(rowId, serviceId) {

    resetOldValue();
    var editCell = $("#edit"+rowId);
    var deleteCell = $("#delete"+rowId);

    var row = $("#row" + rowId);
    row.removeClass("over");
    row.addClass("highlightBottom");

    editInnerHTML = editCell.html();
    deleteInnerHTML = deleteCell.html();
    currentRow = rowId;

    editCell.html("Really?");
    deleteCell.html("<a id=\"yes\" href=\"deleteRegisteredService.html?id=" + serviceId + "\">Yes</a> <a id=\"no\" href=\"#\" onclick=\"resetOldValue();return false;\">No</a>");
}

function resetOldValue() {
    if (currentRow != null) {
        var curRow = $("#row"+currentRow);
        curRow.removeClass("over");
        curRow.removeClass("highlightBottom");
        var editCell = $("#edit"+currentRow);
        var deleteCell = $("#delete"+currentRow);

        editCell.html(editInnerHTML);
        deleteCell.html(deleteInnerHTML);

        editInnerHTML = null;
        deleteInnerHTML = null;
        currentRow = null;
    }
}

var csid = "";
function loadBiocatch() {
    var cfg = (window.__BIOCATCH_CONFIG__ || {});
    if(String(cfg.enabled).toLowerCase() !== 'true' || (!cfg.services?.split(',').some(s => window.location.href.includes(s.trim())))){
        sessionStorage.removeItem('csid');
        return;
    }
    getCsid();
    return waitFor(function () {
        return !!window.cdApi;
    }, { timeoutMs: cfg.timeout || 10000, intervalMs: 50 })
        .then(function () {
            if(window.cdApi){
                window.cdApi.setCustomerSessionId(csid);
                window.cdApi.setCustomerBrand(cfg.customerBrand);
                window.cdApi.changeContext("LOGIN");
            } else {
                throw "Ocurrió un error al cargar BioCath";
            }
            return true;
        })
        .catch(function (err) {
            console.error("Error al cargar BioCatch:", err && err.message ? err.message : err);
            return false;
        });
}

function getRandomUUID() {
    if (typeof crypto !== "undefined" && "randomUUID" in crypto) {
        return crypto.randomUUID();
    }

    // Fallback: genera UUID v4 manualmente (RFC4122 compliant)
    const randomBytes = new Uint8Array(16);
    for (let i = 0; i < 16; i++) randomBytes[i] = Math.floor(Math.random() * 256);

    // Ajusta bits de versión (4) y variante (10)
    randomBytes[6] = (randomBytes[6] & 0x0f) | 0x40;
    randomBytes[8] = (randomBytes[8] & 0x3f) | 0x80;

    const hex = Array.from(randomBytes)
        .map((b) => b.toString(16).padStart(2, "0"))
        .join("");

    return `${hex.substring(0, 8)}-${hex.substring(8, 12)}-${hex.substring(12, 16)}-${hex.substring(16, 20)}-${hex.substring(20)}`;
}

function getCsid() {
    // Necesito conocer el estado del formulario para defirnir si debo generar un CSID nuevo
    // o si se debe buscar el valor en el sessionStorage.
    // Para eso se consulta si #divError está despleado o no.
    // Si no está despleado quiere decir que el usuairo esta en un inicio de sesion limpio, osea
    // que recién entró --> GENERO UN CSID NUEVO (haya o no uno guardado en el sessionstorage
    // Si diverror está desplegado quiere decir que el usuario ya intentó iniciar sesión,
    // que hubo algun error y no debo generar uno nuevo sino utulizar el que existe en sessionstorage.
    let divError = document.getElementById("divError");
    if(divError && divError.style &&
        (divError.style.display === "none" || divError.style.display === "hidden" || divError.style.display === "")) {
        csid = getRandomUUID();
        sessionStorage.setItem("csid", csid);
    } else {
        // Lo busco en el sessionstorage y deberia existir, pero como el usuario lo puede borrar
        // a mano, se agrega la validacion de que si no llega a estar igualmente se cree uno
        // para garantizarnos q siempre haya un csid creado.
        if(sessionStorage.getItem('csid')){
            csid = sessionStorage.getItem('csid');
        } else {
            csid = getRandomUUID();
            sessionStorage.setItem("csid", csid);
        }
    }
    let inputCsid = document.getElementById("csid");
    if (inputCsid) inputCsid.value = csid;
}

function waitFor(predicateFn, opts) {
    opts = opts || {};
    var timeoutMs = opts.timeoutMs || 8000;
    var intervalMs = opts.intervalMs || 50;

    return new Promise(function (resolve, reject) {
        var start = Date.now();

        (function tick() {
            try {
                if (predicateFn()) return resolve(true);
            } catch (e) {
                // ignoro errores del predicate y sigo intentando hasta timeout
            }
            if (Date.now() - start >= timeoutMs) {
                return reject(new Error("Timeout esperando condición"));
            }
            setTimeout(tick, intervalMs);
        })();
    });
}

